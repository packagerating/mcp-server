    "smoke-test": "tsx scripts/smoke-test.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^20.19.42",
    "@vercel/ncc": "^0.38.3",
    "tsx": "^4.22.4",
    "typescript": "^5.4.5",
    "vitest": "^2.0.0"
  }
}
